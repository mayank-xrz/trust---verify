# Copy to .env for local configuration. Never commit real secrets.
# Generate each required secret with:
#   python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# or: openssl rand -hex 32
# Host-side runs only. docker-compose.yml builds DATABASE_URL from the
# POSTGRES_* values below. Fill this in if you run the API outside Compose.
DATABASE_URL=
NODE_ID=node-a
NODE_PORT=8101
WRAP_KEY_REF=local-wrap-key-node-a
WRAP_MASTER_KEY_B64=
TOKEN_SIGNING_SEED_B64=
ADMIN_ENROLL_TOKEN=
CLUSTER_SYNC_SECRET=
MAX_CACHE_STALENESS_MS=5000
AUDIT_LOG_PATH=/tmp/tbv_data/node-a_audit.log
# Required by docker-compose.yml. There is no default database password.
POSTGRES_USER=tbv
POSTGRES_PASSWORD=
POSTGRES_DB=tbv_identity
# Shared by the sandbox demo nodes; generate a fresh 32-byte base64 value.
DEMO_CLUSTER_KEY_B64=
# Human-supplied 5-minute demo recording. Leave empty until the video exists.
# The brief and README must render "video pending" while this is unset.
DEMO_VIDEO_URL=
