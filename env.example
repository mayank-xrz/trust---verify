# Copy to .env for local configuration. Never commit real secrets.
# Set POSTGRES_PASSWORD for Compose. For a host-side database client, set its URL separately.
POSTGRES_PASSWORD=
DATABASE_URL=
NODE_ID=node-a
NODE_PORT=8101
WRAP_KEY_REF=local-wrap-key-node-a
WRAP_MASTER_KEY_B64=
TOKEN_SIGNING_SEED_B64=
ADMIN_ENROLL_TOKEN=
# Bearer tokens for manually launched demo.node.server instances. Use distinct values.
DEMO_OPERATOR_TOKEN=
DEMO_PEER_ENROLL_TOKEN=
DEMO_RECIPIENT_TOKEN=
DEMO_REVOCATION_SYNC_TOKEN=
# Optional device authority and recipient-to-resource mapping for protected sends.
DEMO_DEVICE_AUTHORITY_URL=
DEMO_DEVICE_RESOURCES={}
# Optional recipient-to-revocation-authority base URLs.
DEMO_PEER_AUTHORITIES={}
MAX_CACHE_STALENESS_MS=5000
AUDIT_LOG_PATH=/tmp/tbv_data/node-a_audit.log

# Only enable the interactive sandbox where intended.
DEMO_SANDBOX_ENABLED=0
