{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-but-verify.dev/schemas/envelope.schema.json",
  "title": "PQCMessageEnvelope",
  "description": "Cryptographically bound, post-quantum encrypted messaging envelope (P4-06).",
  "type": "object",
  "required": [
    "version",
    "sender_id",
    "recipient_id",
    "seq_num",
    "session_id",
    "kem_ciphertext",
    "nonce",
    "ciphertext",
    "associated_data",
    "signature",
    "sig_alg",
    "kem_alg"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Envelope specification version"
    },
    "sender_id": {
      "type": "string",
      "description": "Unique identifier of sending node",
      "minLength": 1
    },
    "recipient_id": {
      "type": "string",
      "description": "Unique identifier of target recipient node",
      "minLength": 1
    },
    "seq_num": {
      "type": "integer",
      "description": "Monotonically increasing sequence number per session",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "description": "Cryptographically bound session identifier",
      "minLength": 1
    },
    "kem_ciphertext": {
      "type": "string",
      "description": "Base64-encoded post-quantum KEM encapsulated ciphertext",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "nonce": {
      "type": "string",
      "description": "Base64-encoded AEAD initialization vector / nonce",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "ciphertext": {
      "type": "string",
      "description": "Base64-encoded AEAD encrypted payload",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "associated_data": {
      "type": "object",
      "description": "Authenticated associated data explicitly binding sender, recipient, sequence, and session",
      "required": [
        "sender_id",
        "recipient_id",
        "seq_num",
        "session_id"
      ],
      "properties": {
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1
        },
        "seq_num": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded post-quantum digital signature over canonical header and ciphertext",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "sig_alg": {
      "type": "string",
      "description": "NIST-standardized post-quantum digital signature algorithm",
      "enum": [
        "ML-DSA-65",
        "ML-DSA-87",
        "SLH-DSA-SHA2-128s"
      ]
    },
    "kem_alg": {
      "type": "string",
      "description": "NIST-standardized post-quantum key encapsulation mechanism",
      "enum": [
        "ML-KEM-768",
        "ML-KEM-1024"
      ]
    }
  },
  "additionalProperties": false
}
