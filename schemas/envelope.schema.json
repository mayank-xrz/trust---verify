{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-but-verify.dev/schemas/envelope.schema.json",
  "title": "PQCMessageEnvelope",
  "description": "Cryptographically bound, post-quantum authenticated secure messaging envelope.",
  "type": "object",
  "required": [
    "version",
    "sender_id",
    "recipient_id",
    "seq_num",
    "session_id",
    "kem_ciphertext",
    "nonce",
    "ciphertext",
    "associated_data",
    "signature"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0", "1.0"]
    },
    "message_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{3,64}$"
    },
    "recipient_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{3,64}$"
    },
    "seq_num": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "kem_ciphertext": {
      "type": "string"
    },
    "ephemeral_kem_public_key": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "ciphertext": {
      "type": "string"
    },
    "associated_data": {
      "type": "string"
    },
    "additional_authenticated_data": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "algorithm_suite": {
      "type": "object",
      "properties": {
        "kem": { "type": "string" },
        "sig": { "type": "string" },
        "aead": { "type": "string" }
      }
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
