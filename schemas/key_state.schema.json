{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-but-verify.dev/schemas/key_state.schema.json",
  "title": "KeyState",
  "description": "Key lifecycle, rotation, grace period, and revocation state tracking schema (P4-07).",
  "type": "object",
  "required": [
    "key_id",
    "identity_id",
    "device_id",
    "version",
    "algorithm",
    "public_key",
    "status",
    "created_at",
    "grace_cutoff",
    "revoked_at",
    "authority_sig"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "description": "Unique key identifier",
      "minLength": 1
    },
    "identity_id": {
      "type": "string",
      "description": "Owner identity or service identifier",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "description": "Specific host or enclave device identifier",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "description": "Monotonically increasing key version number",
      "minimum": 1
    },
    "algorithm": {
      "type": "string",
      "description": "Cryptographic algorithm name (e.g., ML-KEM-768, ML-DSA-65)",
      "minLength": 1
    },
    "public_key": {
      "type": "string",
      "description": "Base64-encoded public key bytes",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "status": {
      "type": "string",
      "description": "Lifecycle status of the key",
      "enum": [
        "active",
        "grace",
        "revoked"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "RFC3339 timestamp when key was enrolled",
      "format": "date-time"
    },
    "grace_cutoff": {
      "description": "RFC3339 timestamp when grace period ends, or null if active without rotation",
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "description": "RFC3339 timestamp when key was revoked, or null if not revoked",
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_sig": {
      "type": "string",
      "description": "Base64-encoded authority signature certifying this key record",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "additionalProperties": false
}
