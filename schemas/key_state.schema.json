{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-but-verify.dev/schemas/key_state.schema.json",
  "title": "KeyState",
  "description": "Key lifecycle state schema with atomic rotation, grace period, and cutoff enforcement.",
  "type": "object",
  "required": [
    "key_id",
    "identity_id",
    "version",
    "algorithm",
    "status",
    "created_at"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$"
    },
    "identity_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{3,64}$"
    },
    "owner_node_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "algorithm": {
      "type": "string",
      "enum": ["ML-KEM-768", "ML-KEM-1024", "ML-DSA-65", "ML-DSA-87", "MOCK-KEM-768", "MOCK-DSA-65"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "grace", "revoked", "ACTIVE", "GRACE", "REVOKED", "GRACE_PERIOD", "EXPIRED"]
    },
    "state": {
      "type": "string"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "activated_at": {
      "type": "integer",
      "minimum": 0
    },
    "grace_cutoff": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "grace_period_cutoff": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "revoked_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "revocation_timestamp": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "revocation_reason": {
      "type": ["string", "null"]
    },
    "authority_sig": {
      "type": ["string", "null"]
    },
    "public_key_b64": {
      "type": "string"
    },
    "expires_at": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
