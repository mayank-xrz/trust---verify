{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-but-verify.dev/schemas/audit_event.schema.json",
  "title": "AuditEvent",
  "description": "Injection-safe structured audit record linked by cryptographic hash chains.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "actor_id",
    "service",
    "action",
    "resource",
    "status",
    "metadata",
    "prev_hash",
    "record_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "actor_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "DENIED", "SUSPICIOUS", "ERROR", "success", "denied", "suspicious", "error"]
    },
    "metadata": {
      "type": "object"
    },
    "client_ip": {
      "type": "string"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sig": {
      "type": ["string", "null"]
    },
    "signature": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
